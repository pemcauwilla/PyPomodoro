/* Timer Label */
QLabel[class="pom_view_timer"] {
    font-size: @TIMER_FONT_SIZE;
    font-family: UbuntuMono;
}

/* Start - Pause Button */
QPushButton[class="pom_view_start_btn"]{
    padding: 8px 8px;
    border: 1px solid @SECONDARY_BORDER_COLOR;
    border-radius: 5px;
}

QPushButton[class="pom_view_start_btn"]:pressed {
    border-color: @PRESSED_BORDER_COLOR;
}
