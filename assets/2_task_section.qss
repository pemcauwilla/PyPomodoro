QFrame[class="task_section_frame"] {
    background-color: @SECOND_BG_COLOR;
    border: 2px solid @PRIMARY_BORDER_COLOR;
    border-radius: 15px;

    margin-top: 10px;
}

QLabel[class="pom_view_current_tsk_title_lbl"]{
    font-size: @SUBTITLE_FONT_SIZE;
}

QFrame[class="current_task_frame"] {
    background-color: @THIRD_BG_COLOR;
    border-radius: 10px;
}

QPushButton[class="pom_view_btn"]{
    border: 1px solid @SECONDARY_BORDER_COLOR;
    border-radius: 10px;
}

QPushButton[class="pom_view_btn"]:pressed, QPushButton[class="task_item_btn"]:pressed { 
    border: 1px solid @PRESSED_BORDER_COLOR;
}

/* ------------------- TASK LIST ---------------------- */
QFrame[class="task_list_widget"] {
    background: transparent;
    border-radius: 20px;
}

QFrame[class="task_item"] {
    background: @THIRD_BG_COLOR;
    border-radius: 5px;
}

QScrollArea[class="task_list_scroll"] {
    background-color: @SECOND_BG_COLOR;
    border-radius: 15px;

    margin-top: 20px;
    margin-bottom: 5px;   
}

QPushButton[class="task_item_btn"] {
    border: 1px solid @SECONDARY_BORDER_COLOR;
    background: @SECOND_BG_COLOR;
    
    border-radius: 2px;
}

QLabel[class="task_item_lbl"] {
    font-size: @X_SMALL_FONT_SIZE;
}

QScrollBar:vertical {
    width: 10px;
    background-color: @BG_COLOR;
    border-radius: 15px;
}

QScrollBar::handle:vertical{
    background-color: @PRESSED_BORDER_COLOR;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}