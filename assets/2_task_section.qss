QFrame[class="task_section_frame"] {
    background-color: @SECOND_BG_COLOR;
    border: 2px solid @PRIMARY_BORDER_COLOR;
    border-radius: 15px;

    margin-top: 10px;
}

QLabel[class="pom_view_current_tsk_title_lbl"]{
    font-size: @SUBTITLE_FONT_SIZE;
    
}

QFrame[class="task_frame"] {
    background-color: @THIRD_BG_COLOR;
    border-radius: 10px;
}

QPushButton[class="pom_view_btn"]{
    border: 1px solid @SECONDARY_BORDER_COLOR;
    border-radius: 10px;
}

QPushButton[class="pom_view_btn"]:pressed{
    border: 1px solid @PRESSED_BORDER_COLOR;
}